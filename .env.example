# Copy to .env and fill in. Never commit .env.
# NEAR AI Cloud key (https://cloud.near.ai). Without it, familybox runs in replay mode.
NEAR_AI_CLOUD_API_KEY=
# Optional: a different enclave model (must support tools; see docs/BUILD_LOG.md)
# FAMILYBOX_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Optional: where the box keeps family.toml, files/ and runtime/ (default ./demo)
# FAMILYBOX_HOME=./demo
# Optional, Google Drive import and encrypted backup (see docs/CLOUD.md)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FAMILYBOX_OAUTH_REDIRECT=
# Optional, installing on a fleet board without SSH (scripts/fleet_exec.py)
# JFLEET_TOKEN=
# JFLEET_URL=http://decision-tree.local:8080/admin
# JFLEET_NODE=decision-tree
